# ==============================================================================
# Render Production Environment Variables
# In Render Dashboard -> Your Service -> Environment -> Click "Add from .env"
# and paste these values (updating database & email secrets with your own).
# ==============================================================================

# Server & Runtime
NODE_ENV=production
STRICT_PRODUCTION_CHECKS=false
PORT=10000
API_HOST=0.0.0.0
API_PORT=10000
LOG_LEVEL=info

# Databases (If using Render Blueprint, DATABASE_URL & REDIS_URL are linked automatically)
DATABASE_URL=postgresql://commuteshare:commuteshare@localhost:5432/commuteshare?schema=public
REDIS_URL=redis://localhost:6379

# Security & Authentication Secrets (32+ characters)
AUTH_ACCESS_TOKEN_SECRET=commuteshare-prod-access-token-secret-32-chars-min
AUTH_REFRESH_TOKEN_SECRET=commuteshare-prod-refresh-token-secret-32-chars-min
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
SOCIAL_AUTH_CHALLENGE_TTL_SECONDS=300
OTP_HMAC_SECRET=commuteshare-prod-otp-hmac-secret-32-chars-min
OTP_DEV_CODE=000000
COOKIE_SECRET=c1e4c76b9f2c4a5b1c3d5e7f9a0b2c4d6e8f0a1b2c3d4e5f6a7b5c9d0e1f2a3b

# Identity & Encryption (Base64-encoded 32-byte key)
IDENTITY_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
IDENTITY_HMAC_SECRET=commuteshare-prod-identity-hmac-secret-32-chars

# Email Verification (Gmail SMTP - sends OTP codes to user email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=olajideabdulquadri22@gmail.com
SMTP_PASS=pdkvitevvkogztxi
SMTP_SECURE=true
EMAIL_FROM=RideShare <olajideabdulquadri22@gmail.com>

# SMS Provider (console for demo, or termii / africastalking for production)
SMS_PROVIDER=console
SMS_FALLBACK_PROVIDER=none

# KYC Identity Provider (Ninja Sandbox)
NIN_PROVIDER=ninja
NINJA_BASE_URL=https://api.sandbox.ninja.boucloud.io
NINJA_PUBLIC_KEY=replace_with_ninja_sandbox_public_key
NINJA_SECRET_KEY=replace_with_ninja_sandbox_secret_key
NIN_CONSENT_VERSION=2026-10-01
NIN_RETRY_COOLDOWN_SECONDS=60

# Web Push Notifications
WEB_PUSH_PROVIDER=console

# Payments (Paystack test key)
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=sk_test_replace_with_paystack_test_secret
PAYSTACK_CALLBACK_URL=https://rideshare-api.onrender.com/api/v1/payments/callback

# Storage (Media & Avatars)
STORAGE_REGION=us-east-1
STORAGE_BUCKET=commuteshare-private
STORAGE_ACCESS_KEY_ID=commuteshare
STORAGE_SECRET_ACCESS_KEY=commuteshare-local-secret
STORAGE_FORCE_PATH_STYLE=false
UPLOAD_URL_TTL_SECONDS=900
UPLOAD_MAX_BYTES=10485760
KYC_INSPECTION_MAX_BYTES=10485760

# CORS Allowed Origins (Include your Vercel URL here once created)
CORS_ORIGINS=https://rideshare.vercel.app,http://localhost:5173,http://localhost:8081,http://localhost:3000
