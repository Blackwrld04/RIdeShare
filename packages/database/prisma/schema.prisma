  rideOffer         RideOffer    @relation(fields: [rideOfferId], references: [id], onDelete: Cascade)
  booking           RideBooking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  initiatedBy       User         @relation(fields: [initiatedByUserId], references: [id], onDelete: Restrict)

  @@unique([initiatedByUserId, clientAlertId], map: "safety_alerts_initiator_client_key")
  @@index([initiatedByUserId, createdAt(sort: Desc)], map: "safety_alerts_initiator_created_idx")
  @@index([rideOfferId, status, createdAt(sort: Desc)], map: "safety_alerts_ride_status_created_idx")
  @@map("safety_alerts")
}
