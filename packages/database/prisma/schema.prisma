generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED

  @@map("user_status")
}

enum DriverApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED

  @@map("driver_application_status")
}

enum DriverDocumentStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("driver_document_status")
}

enum UploadStatus {
  PENDING
  READY
  EXPIRED
  QUARANTINED
  DELETED

  @@map("upload_status")
}

enum RideStatus {
  DRAFT
  PUBLISHED
  FULL
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("ride_status")
}

enum RidePointKind {
  ORIGIN
  WAYPOINT
  DESTINATION

  @@map("ride_point_kind")
}

enum BookingStatus {
  PENDING
  AWAITING_PAYMENT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  DECLINED
  CANCELLED
  EXPIRED

  @@map("booking_status")
}

enum PaymentProvider {
  PAYSTACK

  @@map("payment_provider")
}

enum PaymentStatus {
  INITIALIZING
  INITIALIZED
  SUCCEEDED
  FAILED
  REFUND_PENDING
  REFUNDED

  @@map("payment_status")
}

enum RefundStatus {
  REQUESTED
  SUBMITTING
  SUBMITTED
  PROCESSING
  NEEDS_ATTENTION
  PROCESSED
  FAILED

  @@map("refund_status")
}

enum RefundKind {
  PASSENGER_CANCELLATION
  DRIVER_CANCELLATION
  FULFILLMENT_FAILED

  @@map("refund_kind")
}

enum LedgerJournalKind {
  ESCROW_FUNDED
  REFUND_RESERVED
  REFUND_SETTLED
  TRIP_SETTLED
  PAYOUT_SETTLED
  PAYOUT_REVERSED

  @@map("ledger_journal_kind")
}

enum LedgerAccount {
  PLATFORM_CASH
  PASSENGER_ESCROW
  REFUND_PAYABLE
  DRIVER_PAYABLE
  PLATFORM_REVENUE

  @@map("ledger_account")
}

enum LedgerDirection {
  DEBIT
  CREDIT

  @@map("ledger_direction")
}

enum BankAccountStatus {
  VERIFIED
  DISABLED

  @@map("bank_account_status")
}

enum PayoutStatus {
  SCHEDULED
  PROCESSING
  SUBMITTED
  SUCCESS
  FAILED
  REVERSED

  @@map("payout_status")
}

enum IdentityVerificationStatus {
  PENDING
  VERIFIED
  FAILED

  @@map("identity_verification_status")
}

model User {
  id                   String                    @id @default(uuid()) @db.Uuid
  phoneE164            String                    @unique @map("phone_e164") @db.VarChar(16)
  phoneVerifiedAt      DateTime                  @map("phone_verified_at") @db.Timestamptz(3)
  status               UserStatus                @default(ACTIVE)
  createdAt            DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  profile              UserProfile?
  sessions             AuthSession[]
  driverApplication    DriverApplication?
  uploads              UploadAsset[]
  rideBookings         RideBooking[]
  ledgerJournals       LedgerJournal[]
  identityVerification UserIdentityVerification?

  @@map("users")
}

model UserIdentityVerification {
  id                String                     @id @default(uuid()) @db.Uuid
  userId            String                     @unique @map("user_id") @db.Uuid
  status            IdentityVerificationStatus @default(PENDING)
  provider          String                     @db.VarChar(32)
  providerReference String?                    @unique @map("provider_reference") @db.VarChar(100)
  ninCiphertext     Bytes                      @map("nin_ciphertext") @db.ByteA
  ninIv             Bytes                      @map("nin_iv") @db.ByteA
  ninAuthTag        Bytes                      @map("nin_auth_tag") @db.ByteA
  ninLookupHash     String                     @unique @map("nin_lookup_hash") @db.Char(64)
  ninLast4          String                     @map("nin_last4") @db.Char(4)
  legalFirstName    String                     @map("legal_first_name") @db.VarChar(80)
  legalLastName     String                     @map("legal_last_name") @db.VarChar(80)
  dateOfBirth       DateTime                   @map("date_of_birth") @db.Date
  consentVersion    String                     @map("consent_version") @db.VarChar(32)
  consentedAt       DateTime                   @map("consented_at") @db.Timestamptz(3)
  failureReason     String?                    @map("failure_reason") @db.VarChar(280)
  verifiedAt        DateTime?                  @map("verified_at") @db.Timestamptz(3)
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  user              User                       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([status, createdAt], map: "user_identity_verifications_status_created_idx")
  @@map("user_identity_verifications")
}

model UserProfile {
  userId       String   @id @map("user_id") @db.Uuid
  displayName  String?  @map("display_name") @db.VarChar(80)
  billingEmail String?  @unique @map("billing_email") @db.VarChar(255)
  bio          String?  @db.VarChar(280)
  timezone     String   @default("Africa/Lagos") @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model PhoneOtpChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  phoneE164   String    @map("phone_e164") @db.VarChar(16)
  codeDigest  String    @map("code_digest") @db.VarChar(64)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([phoneE164, createdAt(sort: Desc)], map: "phone_otp_challenges_phone_created_idx")
  @@map("phone_otp_challenges")
}

model AuthSession {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  refreshTokenDigest String    @unique @map("refresh_token_digest") @db.VarChar(64)
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt         DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "auth_sessions_user_idx")
  @@index([expiresAt], map: "auth_sessions_expires_idx")
  @@map("auth_sessions")
}

model DriverApplication {
  id                 String                  @id @default(uuid()) @db.Uuid
  userId             String                  @unique @map("user_id") @db.Uuid
  status             DriverApplicationStatus @default(DRAFT)
  legalFirstName     String?                 @map("legal_first_name") @db.VarChar(80)
  legalLastName      String?                 @map("legal_last_name") @db.VarChar(80)
  dateOfBirth        DateTime?               @map("date_of_birth") @db.Date
  residentialAddress String?                 @map("residential_address") @db.VarChar(160)
  city               String?                 @db.VarChar(80)
  state              String?                 @db.VarChar(80)
  submittedAt        DateTime?               @map("submitted_at") @db.Timestamptz(3)
  reviewedAt         DateTime?               @map("reviewed_at") @db.Timestamptz(3)
  decisionReason     String?                 @map("decision_reason") @db.VarChar(500)
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle            DriverVehicle?
  documents          DriverDocument[]
  rides              RideOffer[]
  bankAccount        DriverBankAccount?
  payouts            DriverPayout[]

  @@index([status, submittedAt], map: "driver_applications_status_submitted_idx")
  @@map("driver_applications")
}

model DriverVehicle {
  id                  String            @id @default(uuid()) @db.Uuid
  driverApplicationId String            @unique @map("driver_application_id") @db.Uuid
  make                String            @db.VarChar(80)
  model               String            @db.VarChar(80)
  color               String            @db.VarChar(40)
  year                Int               @db.SmallInt
  registrationNumber  String            @unique @map("registration_number") @db.VarChar(20)
  seatCapacity        Int               @map("seat_capacity") @db.SmallInt
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  application         DriverApplication @relation(fields: [driverApplicationId], references: [id], onDelete: Cascade)

  @@map("driver_vehicles")
}

model DriverDocument {
  id                  String               @id @default(uuid()) @db.Uuid
  driverApplicationId String               @map("driver_application_id") @db.Uuid
  assetId             String?              @unique @map("asset_id") @db.Uuid
  kind                String               @db.VarChar(64)
  storageKey          String               @map("storage_key") @db.VarChar(512)
  contentType         String               @map("content_type") @db.VarChar(100)
  sizeBytes           BigInt               @map("size_bytes")
  checksumSha256      String               @map("checksum_sha256") @db.Char(64)
  issuedOn            DateTime?            @map("issued_on") @db.Date
  expiresOn           DateTime?            @map("expires_on") @db.Date
  status              DriverDocumentStatus @default(PENDING)
  rejectionReason     String?              @map("rejection_reason") @db.VarChar(500)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  application         DriverApplication    @relation(fields: [driverApplicationId], references: [id], onDelete: Cascade)
  asset               UploadAsset?         @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([driverApplicationId, kind], map: "driver_documents_application_kind_key")
  @@index([status], map: "driver_documents_status_idx")
  @@map("driver_documents")
}

model UploadAsset {
  id              String          @id @default(uuid()) @db.Uuid
  ownerUserId     String          @map("owner_user_id") @db.Uuid
  purpose         String          @db.VarChar(64)
  objectKey       String          @unique @map("object_key") @db.VarChar(512)
  contentType     String          @map("content_type") @db.VarChar(100)
  sizeBytes       BigInt          @map("size_bytes")
  checksumSha256  String          @map("checksum_sha256") @db.Char(64)
  status          UploadStatus    @default(PENDING)
  uploadExpiresAt DateTime        @map("upload_expires_at") @db.Timestamptz(3)
  completedAt     DateTime?       @map("completed_at") @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  owner           User            @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  driverDocument  DriverDocument?

  @@index([ownerUserId, status], map: "upload_assets_owner_status_idx")
  @@index([status, uploadExpiresAt], map: "upload_assets_status_expiry_idx")
  @@map("upload_assets")
}

model RideOffer {
  id                  String            @id @default(uuid()) @db.Uuid
  driverApplicationId String            @map("driver_application_id") @db.Uuid
  status              RideStatus        @default(DRAFT)
  departureAt         DateTime          @map("departure_at") @db.Timestamptz(3)
  timezone            String            @default("Africa/Lagos") @db.VarChar(64)
  passengerSeats      Int               @map("passenger_seats") @db.SmallInt
  contributionKobo    BigInt            @map("contribution_kobo")
  currency            String            @default("NGN") @db.Char(3)
  notes               String?           @db.VarChar(280)
  publishedAt         DateTime?         @map("published_at") @db.Timestamptz(3)
  startedAt           DateTime?         @map("started_at") @db.Timestamptz(3)
  completedAt         DateTime?         @map("completed_at") @db.Timestamptz(3)
  cancelledAt         DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason  String?           @map("cancellation_reason") @db.VarChar(280)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  driverApplication   DriverApplication @relation(fields: [driverApplicationId], references: [id], onDelete: Cascade)
  routePoints         RideRoutePoint[]
  bookings            RideBooking[]
  payout              DriverPayout?

  @@index([driverApplicationId, departureAt(sort: Desc)], map: "ride_offers_driver_departure_idx")
  @@index([status, departureAt], map: "ride_offers_status_departure_idx")
  @@map("ride_offers")
}

model RideRoutePoint {
  id             String                                @id @default(uuid()) @db.Uuid
  rideOfferId    String                                @map("ride_offer_id") @db.Uuid
  sequence       Int                                   @db.SmallInt
  kind           RidePointKind
  label          String                                @db.VarChar(120)
  address        String?                               @db.VarChar(200)
  latitude       Decimal                               @db.Decimal(9, 6)
  longitude      Decimal                               @db.Decimal(9, 6)
  externalSource String?                               @map("external_source") @db.VarChar(32)
  externalId     String?                               @map("external_id") @db.VarChar(128)
  location       Unsupported("geography(Point,4326)")?
  createdAt      DateTime                              @default(now()) @map("created_at") @db.Timestamptz(3)
  rideOffer      RideOffer                             @relation(fields: [rideOfferId], references: [id], onDelete: Cascade)

  @@unique([rideOfferId, sequence], map: "ride_route_points_offer_sequence_key")
  @@index([rideOfferId, kind], map: "ride_route_points_offer_kind_idx")
  @@map("ride_route_points")
}

model RideBooking {
  id                    String               @id @default(uuid()) @db.Uuid
  rideOfferId           String               @map("ride_offer_id") @db.Uuid
  passengerUserId       String               @map("passenger_user_id") @db.Uuid
  seats                 Int                  @db.SmallInt
  status                BookingStatus        @default(PENDING)
  unitContributionKobo  BigInt               @map("unit_contribution_kobo")
  totalContributionKobo BigInt               @map("total_contribution_kobo")
  currency              String               @db.Char(3)
  decidedAt             DateTime?            @map("decided_at") @db.Timestamptz(3)
  decisionReason        String?              @map("decision_reason") @db.VarChar(280)
  startedAt             DateTime?            @map("started_at") @db.Timestamptz(3)
  completedAt           DateTime?            @map("completed_at") @db.Timestamptz(3)
  cancelledAt           DateTime?            @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason    String?              @map("cancellation_reason") @db.VarChar(280)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  rideOffer             RideOffer            @relation(fields: [rideOfferId], references: [id], onDelete: Cascade)
  passenger             User                 @relation(fields: [passengerUserId], references: [id], onDelete: Cascade)
  payments              PaymentTransaction[]
  refunds               PaymentRefund[]
  ledgerJournals        LedgerJournal[]

  @@index([rideOfferId, status], map: "ride_bookings_offer_status_idx")
  @@index([passengerUserId, createdAt(sort: Desc)], map: "ride_bookings_passenger_created_idx")
  @@map("ride_bookings")
}

model PaymentTransaction {
  id                    String          @id @default(uuid()) @db.Uuid
  bookingId             String          @map("booking_id") @db.Uuid
  provider              PaymentProvider @default(PAYSTACK)
  status                PaymentStatus   @default(INITIALIZING)
  reference             String          @unique @db.VarChar(100)
  baseAmountKobo        BigInt          @map("base_amount_kobo")
  platformFeeKobo       BigInt          @map("platform_fee_kobo")
  amountKobo            BigInt          @map("amount_kobo")
  currency              String          @db.Char(3)
  authorizationUrl      String?         @map("authorization_url") @db.VarChar(512)
  accessCode            String?         @map("access_code") @db.VarChar(100)
  providerTransactionId String?         @unique @map("provider_transaction_id") @db.VarChar(32)
  providerMessage       String?         @map("provider_message") @db.VarChar(280)
  paidAt                DateTime?       @map("paid_at") @db.Timestamptz(3)
  failedAt              DateTime?       @map("failed_at") @db.Timestamptz(3)
  refundRequiredAt      DateTime?       @map("refund_required_at") @db.Timestamptz(3)
  refundedAt            DateTime?       @map("refunded_at") @db.Timestamptz(3)
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  booking               RideBooking     @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  refund                PaymentRefund?
  ledgerJournals        LedgerJournal[]

  @@index([bookingId, status], map: "payment_transactions_booking_status_idx")
  @@index([status, createdAt], map: "payment_transactions_status_created_idx")
  @@map("payment_transactions")
}

model PaymentRefund {
  id                     String             @id @default(uuid()) @db.Uuid
  paymentId              String             @unique @map("payment_id") @db.Uuid
  bookingId              String             @map("booking_id") @db.Uuid
  kind                   RefundKind
  status                 RefundStatus       @default(REQUESTED)
  amountKobo             BigInt             @map("amount_kobo")
  driverCompensationKobo BigInt             @map("driver_compensation_kobo")
  currency               String             @db.Char(3)
  reason                 String             @db.VarChar(280)
  providerRefundId       String?            @unique @map("provider_refund_id") @db.VarChar(32)
  providerMessage        String?            @map("provider_message") @db.VarChar(280)
  submittedAt            DateTime?          @map("submitted_at") @db.Timestamptz(3)
  processedAt            DateTime?          @map("processed_at") @db.Timestamptz(3)
  failedAt               DateTime?          @map("failed_at") @db.Timestamptz(3)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  payment                PaymentTransaction @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  booking                RideBooking        @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  ledgerJournals         LedgerJournal[]

  @@index([status, createdAt], map: "payment_refunds_status_created_idx")
  @@map("payment_refunds")
}

model LedgerJournal {
  id             String              @id @default(uuid()) @db.Uuid
  bookingId      String?             @map("booking_id") @db.Uuid
  paymentId      String?             @map("payment_id") @db.Uuid
  refundId       String?             @map("refund_id") @db.Uuid
  userId         String?             @map("user_id") @db.Uuid
  payoutId       String?             @map("payout_id") @db.Uuid
  kind           LedgerJournalKind
  idempotencyKey String              @unique @map("idempotency_key") @db.VarChar(160)
  currency       String              @db.Char(3)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  booking        RideBooking?        @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  payment        PaymentTransaction? @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  refund         PaymentRefund?      @relation(fields: [refundId], references: [id], onDelete: Restrict)
  user           User?               @relation(fields: [userId], references: [id], onDelete: Restrict)
  payout         DriverPayout?       @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  entries        LedgerEntry[]

  @@index([bookingId, createdAt], map: "ledger_journals_booking_created_idx")
  @@map("ledger_journals")
}

model DriverBankAccount {
  id                    String            @id @default(uuid()) @db.Uuid
  driverApplicationId   String            @unique @map("driver_application_id") @db.Uuid
  status                BankAccountStatus @default(VERIFIED)
  bankCode              String            @map("bank_code") @db.VarChar(10)
  bankName              String            @map("bank_name") @db.VarChar(120)
  accountName           String            @map("account_name") @db.VarChar(120)
  accountNumberLast4    String            @map("account_number_last4") @db.Char(4)
  providerRecipientCode String            @unique @map("provider_recipient_code") @db.VarChar(40)
  resolvedAt            DateTime          @map("resolved_at") @db.Timestamptz(3)
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  application           DriverApplication @relation(fields: [driverApplicationId], references: [id], onDelete: Restrict)
  payouts               DriverPayout[]

  @@map("driver_bank_accounts")
}

model DriverPayout {
  id                   String            @id @default(uuid()) @db.Uuid
  rideOfferId          String            @unique @map("ride_offer_id") @db.Uuid
  driverApplicationId  String            @map("driver_application_id") @db.Uuid
  bankAccountId        String            @map("bank_account_id") @db.Uuid
  status               PayoutStatus      @default(SCHEDULED)
  amountKobo           BigInt            @map("amount_kobo")
  currency             String            @db.Char(3)
  reference            String            @unique @db.VarChar(50)
  providerTransferCode String?           @unique @map("provider_transfer_code") @db.VarChar(40)
  providerMessage      String?           @map("provider_message") @db.VarChar(280)
  scheduledFor         DateTime          @map("scheduled_for") @db.Timestamptz(3)
  attemptedAt          DateTime?         @map("attempted_at") @db.Timestamptz(3)
  submittedAt          DateTime?         @map("submitted_at") @db.Timestamptz(3)
  completedAt          DateTime?         @map("completed_at") @db.Timestamptz(3)
  failedAt             DateTime?         @map("failed_at") @db.Timestamptz(3)
  attemptCount         Int               @default(0) @map("attempt_count")
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  rideOffer            RideOffer         @relation(fields: [rideOfferId], references: [id], onDelete: Restrict)
  driverApplication    DriverApplication @relation(fields: [driverApplicationId], references: [id], onDelete: Restrict)
  bankAccount          DriverBankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  ledgerJournals       LedgerJournal[]

  @@index([status, scheduledFor], map: "driver_payouts_status_scheduled_idx")
  @@index([driverApplicationId, createdAt(sort: Desc)], map: "driver_payouts_driver_created_idx")
  @@map("driver_payouts")
}

model LedgerEntry {
  id         String          @id @default(uuid()) @db.Uuid
  journalId  String          @map("journal_id") @db.Uuid
  account    LedgerAccount
  direction  LedgerDirection
  amountKobo BigInt          @map("amount_kobo")
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  journal    LedgerJournal   @relation(fields: [journalId], references: [id], onDelete: Restrict)

  @@index([account, createdAt], map: "ledger_entries_account_created_idx")
  @@map("ledger_entries")
}
