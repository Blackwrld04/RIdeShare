generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED

  @@map("user_status")
}

enum UserRole {
  USER
  REVIEWER
  ADMIN

  @@map("user_role")
}

enum ProfileGender {
  WOMAN
  MAN
  NON_BINARY
  PREFER_NOT_TO_SAY

  @@map("profile_gender")
}

enum DriverApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED

  @@map("driver_application_status")
}

enum DriverDocumentStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("driver_document_status")
}

enum UploadStatus {
  PENDING
  READY
  EXPIRED
  QUARANTINED
  DELETED

  @@map("upload_status")
}

enum RideStatus {
  DRAFT
  PUBLISHED
  FULL
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("ride_status")
}

enum RidePointKind {
  ORIGIN
  WAYPOINT
  DESTINATION

  @@map("ride_point_kind")
}

enum BookingStatus {
  PENDING
  AWAITING_PAYMENT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  DISPUTED
  DECLINED
  CANCELLED
  EXPIRED

  @@map("booking_status")
}

enum PaymentProvider {
  PAYSTACK

  @@map("payment_provider")
}

enum PaymentStatus {
  INITIALIZING
  INITIALIZED
  SUCCEEDED
  FAILED
  REFUND_PENDING
  REFUNDED

  @@map("payment_status")
}

enum RefundStatus {
  REQUESTED
  SUBMITTING
  SUBMITTED
  PROCESSING
  NEEDS_ATTENTION
  PROCESSED
  FAILED

  @@map("refund_status")
}

enum RefundKind {
  PASSENGER_CANCELLATION
  DRIVER_CANCELLATION
  FULFILLMENT_FAILED
  DISPUTE_RESOLUTION

  @@map("refund_kind")
}

enum LedgerJournalKind {
  ESCROW_FUNDED
  REFUND_RESERVED
  REFUND_SETTLED
  TRIP_SETTLED
  PAYOUT_SETTLED
  PAYOUT_REVERSED

  @@map("ledger_journal_kind")
}

enum LedgerAccount {
  PLATFORM_CASH
  PASSENGER_ESCROW
  REFUND_PAYABLE
  DRIVER_PAYABLE
  PLATFORM_REVENUE

  @@map("ledger_account")
}

enum LedgerDirection {
  DEBIT
  CREDIT

  @@map("ledger_direction")
}

enum BankAccountStatus {
  VERIFIED
  DISABLED

  @@map("bank_account_status")
}

enum PayoutStatus {
  SCHEDULED
  ON_HOLD
  CANCELLED
  PROCESSING
  SUBMITTED
  SUCCESS
  FAILED
  REVERSED

  @@map("payout_status")
}

enum PaymentDisputeStatus {
  OPEN
  RELEASED
  REFUNDED

  @@map("payment_dispute_status")
}

enum IdentityVerificationStatus {
  PENDING
  VERIFIED
  FAILED

  @@map("identity_verification_status")
}

enum PushDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED

  @@map("push_delivery_status")
}

enum UserReportCategory {
  SAFETY
  HARASSMENT
  FRAUD
  NO_SHOW
  OTHER

  @@map("user_report_category")
}

enum UserReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED

  @@map("user_report_status")
}

enum RideSeriesStatus {
  ACTIVE
  PAUSED
  CANCELLED

  @@map("ride_series_status")
}

model User {
  id                   String                    @id @default(uuid()) @db.Uuid
  phoneE164            String                    @unique @map("phone_e164") @db.VarChar(16)
  phoneVerifiedAt      DateTime                  @map("phone_verified_at") @db.Timestamptz(3)
  status               UserStatus                @default(ACTIVE)
  role                 UserRole                  @default(USER)
  createdAt            DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  profile              UserProfile?
  sessions             AuthSession[]
  socialAccounts       SocialAccount[]
  driverApplication    DriverApplication?
  uploads              UploadAsset[]
  rideBookings         RideBooking[]
  ledgerJournals       LedgerJournal[]
  identityVerification UserIdentityVerification?
  notifications        UserNotification[]
  webPushSubscriptions WebPushSubscription[]
  authoredRideReviews  RideReview[]              @relation("RideReviewAuthor")
  receivedRideReviews  RideReview[]              @relation("RideReviewSubject")
  submittedReports     UserReport[]              @relation("UserReportReporter")
  receivedReports      UserReport[]              @relation("UserReportSubject")
  reviewedReports      UserReport[]              @relation("UserReportReviewer")
  openedPaymentDisputes PaymentDispute[]          @relation("PaymentDisputeOpenedBy")
  reviewedPaymentDisputes PaymentDispute[]        @relation("PaymentDisputeReviewedBy")
  chatMessages         ChatMessage[]             @relation("ChatMessageSender")
  chatReadReceipts     ChatReadReceipt[]
  emergencyContacts    EmergencyContact[]
  rideLocationPings    RideLocationPing[]
  rideShareLinks       RideShareLink[]
  safetyAlerts         SafetyAlert[]
  reviewedApplications DriverApplication[]       @relation("DriverApplicationReviewer")
  reviewedDocuments    DriverDocument[]          @relation("DriverDocumentReviewer")

  @@map("users")
}

model SocialAuthChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  provider    String    @db.VarChar(32)
  nonceDigest String    @map("nonce_digest") @db.Char(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([expiresAt], map: "social_auth_challenges_expiry_idx")
  @@map("social_auth_challenges")
}

model SocialAccount {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  provider        String   @db.VarChar(32)
  providerSubject String   @map("provider_subject") @db.VarChar(255)
  email           String?  @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject], map: "social_accounts_provider_subject_key")
  @@unique([userId, provider], map: "social_accounts_user_provider_key")
  @@index([userId], map: "social_accounts_user_idx")
  @@map("social_accounts")
}

model UserIdentityVerification {
  id                String                     @id @default(uuid()) @db.Uuid
  userId            String                     @unique @map("user_id") @db.Uuid
  status            IdentityVerificationStatus @default(PENDING)
  provider          String                     @db.VarChar(32)
  providerReference String?                    @unique @map("provider_reference") @db.VarChar(100)
  ninCiphertext     Bytes                      @map("nin_ciphertext") @db.ByteA
  ninIv             Bytes                      @map("nin_iv") @db.ByteA
  ninAuthTag        Bytes                      @map("nin_auth_tag") @db.ByteA
  ninLookupHash     String                     @unique @map("nin_lookup_hash") @db.Char(64)
  ninLast4          String                     @map("nin_last4") @db.Char(4)
  legalFirstName    String                     @map("legal_first_name") @db.VarChar(80)
  legalLastName     String                     @map("legal_last_name") @db.VarChar(80)
  dateOfBirth       DateTime                   @map("date_of_birth") @db.Date
  consentVersion    String                     @map("consent_version") @db.VarChar(32)
  consentedAt       DateTime                   @map("consented_at") @db.Timestamptz(3)
  failureReason     String?                    @map("failure_reason") @db.VarChar(280)
  verifiedAt        DateTime?                  @map("verified_at") @db.Timestamptz(3)
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  user              User                       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([status, createdAt], map: "user_identity_verifications_status_created_idx")
  @@map("user_identity_verifications")
}

model UserProfile {
  userId       String   @id @map("user_id") @db.Uuid
  displayName  String?  @map("display_name") @db.VarChar(80)
  billingEmail String?  @unique @map("billing_email") @db.VarChar(255)
  bio          String?  @db.VarChar(280)
  gender       ProfileGender?
  timezone     String   @default("Africa/Lagos") @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model PhoneOtpChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  phoneE164   String    @map("phone_e164") @db.VarChar(16)
  codeDigest  String    @map("code_digest") @db.VarChar(64)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  deliveryProvider String? @map("delivery_provider") @db.VarChar(255)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([phoneE164, createdAt(sort: Desc)], map: "phone_otp_challenges_phone_created_idx")
  @@map("phone_otp_challenges")
}

model AuthSession {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  refreshTokenDigest String    @unique @map("refresh_token_digest") @db.VarChar(64)
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt         DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "auth_sessions_user_idx")
  @@index([expiresAt], map: "auth_sessions_expires_idx")
  @@map("auth_sessions")
}

model DriverApplication {
  id                 String                  @id @default(uuid()) @db.Uuid
  userId             String                  @unique @map("user_id") @db.Uuid
  status             DriverApplicationStatus @default(DRAFT)
  legalFirstName     String?                 @map("legal_first_name") @db.VarChar(80)
  legalLastName      String?                 @map("legal_last_name") @db.VarChar(80)
  dateOfBirth        DateTime?               @map("date_of_birth") @db.Date
  residentialAddress String?                 @map("residential_address") @db.VarChar(160)
  city               String?                 @db.VarChar(80)
  state              String?                 @db.VarChar(80)
  submittedAt        DateTime?               @map("submitted_at") @db.Timestamptz(3)
  reviewedAt         DateTime?               @map("reviewed_at") @db.Timestamptz(3)
  reviewedByUserId   String?                 @map("reviewed_by_user_id") @db.Uuid
  decisionReason     String?                 @map("decision_reason") @db.VarChar(500)
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy         User?                   @relation("DriverApplicationReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  vehicle            DriverVehicle?
  documents          DriverDocument[]
  rides              RideOffer[]
  bankAccount        DriverBankAccount?
  payouts            DriverPayout[]
  rideSeries         RideSeries[]

  @@index([status, submittedAt], map: "driver_applications_status_submitted_idx")
  @@index([reviewedByUserId], map: "driver_applications_reviewer_idx")
  @@map("driver_applications")
}

model DriverVehicle {
  id                  String            @id @default(uuid()) @db.Uuid
  driverApplicationId String            @unique @map("driver_application_id") @db.Uuid
  make                String            @db.VarChar(80)
  model               String            @db.VarChar(80)
  color               String            @db.VarChar(40)
  year                Int               @db.SmallInt
  registrationNumber  String            @unique @map("registration_number") @db.VarChar(20)
  seatCapacity        Int               @map("seat_capacity") @db.SmallInt
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  application         DriverApplication @relation(fields: [driverApplicationId], references: [id], onDelete: Cascade)

  @@map("driver_vehicles")
}

model DriverDocument {
  id                  String               @id @default(uuid()) @db.Uuid
  driverApplicationId String               @map("driver_application_id") @db.Uuid
  assetId             String?              @unique @map("asset_id") @db.Uuid
  kind                String               @db.VarChar(64)
  storageKey          String               @map("storage_key") @db.VarChar(512)
  contentType         String               @map("content_type") @db.VarChar(100)
  sizeBytes           BigInt               @map("size_bytes")
  checksumSha256      String               @map("checksum_sha256") @db.Char(64)
  issuedOn            DateTime?            @map("issued_on") @db.Date
  expiresOn           DateTime?            @map("expires_on") @db.Date
  status              DriverDocumentStatus @default(PENDING)
  rejectionReason     String?              @map("rejection_reason") @db.VarChar(500)
  reviewedAt          DateTime?            @map("reviewed_at") @db.Timestamptz(3)
  reviewedByUserId    String?              @map("reviewed_by_user_id") @db.Uuid
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  application         DriverApplication    @relation(fields: [driverApplicationId], references: [id], onDelete: Cascade)
  asset               UploadAsset?         @relation(fields: [assetId], references: [id], onDelete: Restrict)
  reviewedBy          User?                @relation("DriverDocumentReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@unique([driverApplicationId, kind], map: "driver_documents_application_kind_key")
  @@index([status], map: "driver_documents_status_idx")
  @@index([reviewedByUserId], map: "driver_documents_reviewer_idx")
  @@map("driver_documents")
}

model UploadAsset {
  id              String          @id @default(uuid()) @db.Uuid
  ownerUserId     String          @map("owner_user_id") @db.Uuid
  purpose         String          @db.VarChar(64)
  documentKind    String?         @map("document_kind") @db.VarChar(64)
  objectKey       String          @unique @map("object_key") @db.VarChar(512)
  contentType     String          @map("content_type") @db.VarChar(100)
  sizeBytes       BigInt          @map("size_bytes")
  checksumSha256  String          @map("checksum_sha256") @db.Char(64)
  detectedContentType String?     @map("detected_content_type") @db.VarChar(100)
  mediaWidth      Int?            @map("media_width")
  mediaHeight     Int?            @map("media_height")
  status          UploadStatus    @default(PENDING)
  uploadExpiresAt DateTime        @map("upload_expires_at") @db.Timestamptz(3)
  completedAt     DateTime?       @map("completed_at") @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  owner           User            @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  driverDocument  DriverDocument?

  @@index([ownerUserId, status], map: "upload_assets_owner_status_idx")
  @@index([status, uploadExpiresAt], map: "upload_assets_status_expiry_idx")
  @@map("upload_assets")
}

model RideOffer {
  id                   String                                    @id @default(uuid()) @db.Uuid
  driverApplicationId  String                                    @map("driver_application_id") @db.Uuid
  status               RideStatus                                @default(DRAFT)
  departureAt          DateTime                                  @map("departure_at") @db.Timestamptz(3)
  timezone             String                                    @default("Africa/Lagos") @db.VarChar(64)
  passengerSeats       Int                                       @map("passenger_seats") @db.SmallInt
  contributionKobo     BigInt                                    @map("contribution_kobo")
  currency             String                                    @default("NGN") @db.Char(3)
  womenOnly            Boolean                                   @default(false) @map("women_only")
  routePath            Json?                                     @map("route_path") @db.JsonB
  routeDistanceMeters  Int?                                      @map("route_distance_meters")
  routeDurationSeconds Int?                                      @map("route_duration_seconds")
  routingSource        String?                                   @map("routing_source") @db.VarChar(32)
  routingProfile       String?                                   @map("routing_profile") @db.VarChar(32)
  routeCorridor        Unsupported("geometry(LineString,4326)")? @map("route_corridor")
  seriesId             String?                                   @map("series_id") @db.Uuid
  serviceDate          DateTime?                                 @map("service_date") @db.Date
  notes                String?                                   @db.VarChar(280)
  publishedAt          DateTime?                                 @map("published_at") @db.Timestamptz(3)
  startedAt            DateTime?                                 @map("started_at") @db.Timestamptz(3)
  completedAt          DateTime?                                 @map("completed_at") @db.Timestamptz(3)
  cancelledAt          DateTime?                                 @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason   String?                                   @map("cancellation_reason") @db.VarChar(280)
  createdAt            DateTime                                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  driverApplication    DriverApplication                         @relation(fields: [driverApplicationId], references: [id], onDelete: Cascade)
  routePoints          RideRoutePoint[]
  bookings             RideBooking[]
  payout               DriverPayout?
  series               RideSeries?                               @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  locationPings        RideLocationPing[]
  shareLinks           RideShareLink[]
  safetyAlerts         SafetyAlert[]

  @@unique([seriesId, serviceDate], map: "ride_offers_series_service_date_key")
  @@index([driverApplicationId, departureAt(sort: Desc)], map: "ride_offers_driver_departure_idx")
  @@index([status, departureAt], map: "ride_offers_status_departure_idx")
  @@map("ride_offers")
}

model RideSeries {
  id                   String                                    @id @default(uuid()) @db.Uuid
  driverApplicationId  String                                    @map("driver_application_id") @db.Uuid
  status               RideSeriesStatus                          @default(ACTIVE)
  timezone             String                                    @db.VarChar(64)
  departureTimeMinutes Int                                       @map("departure_time_minutes") @db.SmallInt
  daysOfWeek           Int[]                                     @map("days_of_week") @db.SmallInt
  startsOn             DateTime                                  @map("starts_on") @db.Date
  endsOn               DateTime?                                 @map("ends_on") @db.Date
  lookaheadDays        Int                                       @default(14) @map("lookahead_days") @db.SmallInt
  passengerSeats       Int                                       @map("passenger_seats") @db.SmallInt
  contributionKobo     BigInt                                    @map("contribution_kobo")
  currency             String                                    @default("NGN") @db.Char(3)
  womenOnly            Boolean                                   @default(false) @map("women_only")
  routePath            Json                                      @map("route_path") @db.JsonB
  routeDistanceMeters  Int                                       @map("route_distance_meters")
  routeDurationSeconds Int                                       @map("route_duration_seconds")
  routingSource        String?                                   @map("routing_source") @db.VarChar(32)
  routingProfile       String?                                   @map("routing_profile") @db.VarChar(32)
  routeCorridor        Unsupported("geometry(LineString,4326)")? @map("route_corridor")
  notes                String?                                   @db.VarChar(280)
  lastGeneratedThrough DateTime?                                 @map("last_generated_through") @db.Date
  createdAt            DateTime                                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  driverApplication    DriverApplication                         @relation(fields: [driverApplicationId], references: [id], onDelete: Restrict)
  routePoints          RideSeriesRoutePoint[]
  rides                RideOffer[]

  @@index([driverApplicationId, status], map: "ride_series_driver_status_idx")
  @@index([status, startsOn, endsOn], map: "ride_series_schedule_idx")
  @@map("ride_series")
}

model SafeLandmark {
  id                String                 @id @default(uuid()) @db.Uuid
  name              String                 @db.VarChar(120)
  address           String                 @db.VarChar(200)
  category          String                 @db.VarChar(64)
  city              String                 @db.VarChar(80)
  state             String                 @db.VarChar(80)
  latitude          Decimal                @db.Decimal(9, 6)
  longitude         Decimal                @db.Decimal(9, 6)
  location          Unsupported("geography(Point,4326)")?
  externalSource    String?                @map("external_source") @db.VarChar(32)
  externalId        String?                @map("external_id") @db.VarChar(128)
  safetyNotes       String?                @map("safety_notes") @db.VarChar(500)
  metadata          Json?                  @db.JsonB
  isActive          Boolean                @default(true) @map("is_active")
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  routePoints       RideRoutePoint[]
  seriesRoutePoints RideSeriesRoutePoint[]

  @@unique([externalSource, externalId], map: "safe_landmarks_external_key")
  @@index([city, isActive], map: "safe_landmarks_city_active_idx")
  @@index([category, isActive], map: "safe_landmarks_category_active_idx")
  @@map("safe_landmarks")
}

model RideSeriesRoutePoint {
  id             String        @id @default(uuid()) @db.Uuid
  rideSeriesId   String        @map("ride_series_id") @db.Uuid
  sequence       Int           @db.SmallInt
  kind           RidePointKind
  label          String        @db.VarChar(120)
  address        String?       @db.VarChar(200)
  latitude       Decimal       @db.Decimal(9, 6)
  longitude      Decimal       @db.Decimal(9, 6)
  externalSource String?       @map("external_source") @db.VarChar(32)
  externalId     String?       @map("external_id") @db.VarChar(128)
  safeLandmarkId String?       @map("safe_landmark_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  series         RideSeries    @relation(fields: [rideSeriesId], references: [id], onDelete: Cascade)
  safeLandmark   SafeLandmark? @relation(fields: [safeLandmarkId], references: [id], onDelete: SetNull)

  @@unique([rideSeriesId, sequence], map: "ride_series_route_points_series_sequence_key")
  @@index([safeLandmarkId], map: "ride_series_route_points_landmark_idx")
  @@map("ride_series_route_points")
}

model RideRoutePoint {
  id             String                                @id @default(uuid()) @db.Uuid
  rideOfferId    String                                @map("ride_offer_id") @db.Uuid
  sequence       Int                                   @db.SmallInt
  kind           RidePointKind
  label          String                                @db.VarChar(120)
  address        String?                               @db.VarChar(200)
  latitude       Decimal                               @db.Decimal(9, 6)
  longitude      Decimal                               @db.Decimal(9, 6)
  externalSource String?                               @map("external_source") @db.VarChar(32)
  externalId     String?                               @map("external_id") @db.VarChar(128)
  safeLandmarkId String?                               @map("safe_landmark_id") @db.Uuid
  location       Unsupported("geography(Point,4326)")?
  createdAt      DateTime                              @default(now()) @map("created_at") @db.Timestamptz(3)
  rideOffer      RideOffer                             @relation(fields: [rideOfferId], references: [id], onDelete: Cascade)
  safeLandmark   SafeLandmark?                         @relation(fields: [safeLandmarkId], references: [id], onDelete: SetNull)

  @@unique([rideOfferId, sequence], map: "ride_route_points_offer_sequence_key")
  @@index([rideOfferId, kind], map: "ride_route_points_offer_kind_idx")
  @@index([safeLandmarkId], map: "ride_route_points_landmark_idx")
