generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED

  @@map("user_status")
}

enum DriverApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED

  @@map("driver_application_status")
}

enum DriverDocumentStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("driver_document_status")
}

enum UploadStatus {
  PENDING
  READY
  EXPIRED
  QUARANTINED
  DELETED

  @@map("upload_status")
}

enum RideStatus {
  DRAFT
  PUBLISHED
  FULL
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("ride_status")
}

enum RidePointKind {
  ORIGIN
  WAYPOINT
  DESTINATION

  @@map("ride_point_kind")
}

model User {
  id                String             @id @default(uuid()) @db.Uuid
  phoneE164         String             @unique @map("phone_e164") @db.VarChar(16)
  phoneVerifiedAt   DateTime           @map("phone_verified_at") @db.Timestamptz(3)
  status            UserStatus         @default(ACTIVE)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  profile           UserProfile?
  sessions          AuthSession[]
  driverApplication DriverApplication?
  uploads           UploadAsset[]

  @@map("users")
}

model UserProfile {
  userId      String   @id @map("user_id") @db.Uuid
  displayName String?  @map("display_name") @db.VarChar(80)
  bio         String?  @db.VarChar(280)
  timezone    String   @default("Africa/Lagos") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model PhoneOtpChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  phoneE164   String    @map("phone_e164") @db.VarChar(16)
  codeDigest  String    @map("code_digest") @db.VarChar(64)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([phoneE164, createdAt(sort: Desc)], map: "phone_otp_challenges_phone_created_idx")
  @@map("phone_otp_challenges")
}

model AuthSession {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  refreshTokenDigest String    @unique @map("refresh_token_digest") @db.VarChar(64)
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt         DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "auth_sessions_user_idx")
  @@index([expiresAt], map: "auth_sessions_expires_idx")
  @@map("auth_sessions")
}

model DriverApplication {
  id                 String                  @id @default(uuid()) @db.Uuid
  userId             String                  @unique @map("user_id") @db.Uuid
  status             DriverApplicationStatus @default(DRAFT)
  legalFirstName     String?                 @map("legal_first_name") @db.VarChar(80)
  legalLastName      String?                 @map("legal_last_name") @db.VarChar(80)
  dateOfBirth        DateTime?               @map("date_of_birth") @db.Date
  residentialAddress String?                 @map("residential_address") @db.VarChar(160)
  city               String?                 @db.VarChar(80)
  state              String?                 @db.VarChar(80)
  submittedAt        DateTime?               @map("submitted_at") @db.Timestamptz(3)
  reviewedAt         DateTime?               @map("reviewed_at") @db.Timestamptz(3)
  decisionReason     String?                 @map("decision_reason") @db.VarChar(500)
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle            DriverVehicle?
  documents          DriverDocument[]
  rides              RideOffer[]

  @@index([status, submittedAt], map: "driver_applications_status_submitted_idx")
  @@map("driver_applications")
}

model DriverVehicle {
  id                  String            @id @default(uuid()) @db.Uuid
  driverApplicationId String            @unique @map("driver_application_id") @db.Uuid
  make                String            @db.VarChar(80)
  model               String            @db.VarChar(80)
  color               String            @db.VarChar(40)
  year                Int               @db.SmallInt
  registrationNumber  String            @unique @map("registration_number") @db.VarChar(20)
  seatCapacity        Int               @map("seat_capacity") @db.SmallInt
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  application         DriverApplication @relation(fields: [driverApplicationId], references: [id], onDelete: Cascade)

  @@map("driver_vehicles")
}

model DriverDocument {
  id                  String               @id @default(uuid()) @db.Uuid
  driverApplicationId String               @map("driver_application_id") @db.Uuid
  assetId             String?              @unique @map("asset_id") @db.Uuid
  kind                String               @db.VarChar(64)
  storageKey          String               @map("storage_key") @db.VarChar(512)
  contentType         String               @map("content_type") @db.VarChar(100)
  sizeBytes           BigInt               @map("size_bytes")
  checksumSha256      String               @map("checksum_sha256") @db.Char(64)
  issuedOn            DateTime?            @map("issued_on") @db.Date
  expiresOn           DateTime?            @map("expires_on") @db.Date
  status              DriverDocumentStatus @default(PENDING)
  rejectionReason     String?              @map("rejection_reason") @db.VarChar(500)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  application         DriverApplication    @relation(fields: [driverApplicationId], references: [id], onDelete: Cascade)
  asset               UploadAsset?         @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([driverApplicationId, kind], map: "driver_documents_application_kind_key")
  @@index([status], map: "driver_documents_status_idx")
  @@map("driver_documents")
}

model UploadAsset {
  id              String          @id @default(uuid()) @db.Uuid
  ownerUserId     String          @map("owner_user_id") @db.Uuid
  purpose         String          @db.VarChar(64)
  objectKey       String          @unique @map("object_key") @db.VarChar(512)
  contentType     String          @map("content_type") @db.VarChar(100)
  sizeBytes       BigInt          @map("size_bytes")
  checksumSha256  String          @map("checksum_sha256") @db.Char(64)
  status          UploadStatus    @default(PENDING)
  uploadExpiresAt DateTime        @map("upload_expires_at") @db.Timestamptz(3)
  completedAt     DateTime?       @map("completed_at") @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  owner           User            @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  driverDocument  DriverDocument?

  @@index([ownerUserId, status], map: "upload_assets_owner_status_idx")
  @@index([status, uploadExpiresAt], map: "upload_assets_status_expiry_idx")
  @@map("upload_assets")
}

model RideOffer {
  id                  String            @id @default(uuid()) @db.Uuid
  driverApplicationId String            @map("driver_application_id") @db.Uuid
  status              RideStatus        @default(DRAFT)
  departureAt         DateTime          @map("departure_at") @db.Timestamptz(3)
  timezone            String            @default("Africa/Lagos") @db.VarChar(64)
  passengerSeats      Int               @map("passenger_seats") @db.SmallInt
  contributionKobo    BigInt            @map("contribution_kobo")
  currency            String            @default("NGN") @db.Char(3)
  notes               String?           @db.VarChar(280)
  publishedAt         DateTime?         @map("published_at") @db.Timestamptz(3)
  cancelledAt         DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason  String?           @map("cancellation_reason") @db.VarChar(280)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  driverApplication   DriverApplication @relation(fields: [driverApplicationId], references: [id], onDelete: Cascade)
  routePoints         RideRoutePoint[]

  @@index([driverApplicationId, departureAt(sort: Desc)], map: "ride_offers_driver_departure_idx")
  @@index([status, departureAt], map: "ride_offers_status_departure_idx")
  @@map("ride_offers")
}

model RideRoutePoint {
  id             String                                @id @default(uuid()) @db.Uuid
  rideOfferId    String                                @map("ride_offer_id") @db.Uuid
  sequence       Int                                   @db.SmallInt
  kind           RidePointKind
  label          String                                @db.VarChar(120)
  address        String?                               @db.VarChar(200)
  latitude       Decimal                               @db.Decimal(9, 6)
  longitude      Decimal                               @db.Decimal(9, 6)
  externalSource String?                               @map("external_source") @db.VarChar(32)
  externalId     String?                               @map("external_id") @db.VarChar(128)
  location       Unsupported("geography(Point,4326)")?
  createdAt      DateTime                              @default(now()) @map("created_at") @db.Timestamptz(3)
  rideOffer      RideOffer                             @relation(fields: [rideOfferId], references: [id], onDelete: Cascade)

  @@unique([rideOfferId, sequence], map: "ride_route_points_offer_sequence_key")
  @@index([rideOfferId, kind], map: "ride_route_points_offer_kind_idx")
  @@map("ride_route_points")
}
