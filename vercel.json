{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --prefix apps/mobile --legacy-peer-deps && npm install nodemailer --legacy-peer-deps",
  "buildCommand": "npm run build:web --prefix apps/mobile",
  "outputDirectory": "apps/mobile/dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
